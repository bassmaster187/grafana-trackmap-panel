{
  "name": "grafana-trackmap-panel",
  "version": "3.0.0",
  "description": "A plugin for Grafana that visualizes GPS points as a line on an interactive map.",
  "scripts": {
    "build": "webpack -c ./webpack.config.js --env production",
    "dev": "webpack -c ./webpack.config.js --env development",
    "watch": "webpack -c ./webpack.config.js --watch --env development",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js --ext .tsx --ext .ts .",
    "lint:fix": "npm run lint -- --fix && shx mkdir -p node_modules/.cache/eslint && eslint --output-file=node_modules/.cache/eslint/eslint_cache --format=cache --cache --ignore-path ./.gitignore --ext .js --ext .tsx --ext .ts .",
    "sign": "npx @grafana/sign-plugin sign"
  },
  "author": {
    "name": "Carey Metcalfe",
    "url": "https://cmetcalfe.ca"
  },
  "keywords": [
    "trackmap",
    "track",
    "map",
    "gps",
    "latitude",
    "longitude",
    "grafana",
    "plugin",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pR0Ps/grafana-trackmap-panel.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^1.3.0-rc1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.3.10",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "shx": "^0.3.4",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "dependencies": {
    "@grafana/data": "^10.0.1",
    "@grafana/runtime": "^10.0.1",
    "leaflet": "^1.9.4"
  }
}
